{
  "name": "directus-extension-gallery-grid",
  "version": "1.0.1",
  "description": "Grid layout gallery with drag-and-drop, cover image selection, and cover display.",
  "icon": "grid_view",
  "keywords": [
    "directus",
    "directus-extension",
    "gallery",
    "grid",
    "images",
    "files",
    "drag-and-drop",
    "cover-image"
  ],
  "author": "Miša <ibull37@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bulkmaker/directus-extension-gallery-grid"
  },
  "homepage": "https://github.com/bulkmaker/directus-extension-gallery-grid#readme",
  "bugs": {
    "url": "https://github.com/bulkmaker/directus-extension-gallery-grid/issues"
  },
  "type": "module",
  "directus:extension": {
    "type": "bundle",
    "path": {
      "app": "dist/app.js",
      "api": "dist/api.js"
    },
    "entries": [
      {
        "type": "interface",
        "name": "gallery-grid",
        "source": "src/interface/index.ts"
      },
      {
        "type": "display",
        "name": "gallery-grid-cover",
        "source": "src/display/index.ts"
      }
    ],
    "host": "^10.10.0 || ^11.0.0"
  },
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build -w --no-minify"
  },
  "dependencies": {
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@directus/extensions-sdk": "^12.0.1",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "vue": "^3.4.0"
  },
  "files": [
    "dist",
    "package.json",
    "README.md"
  ]
}
